# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (Supabase connection pooler recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Auth
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OpenAI (embeddings)
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# Mistral AI (document parsing / OCR)
MISTRAL_API_KEY=...
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Anthropic (corpus suggestion for new specialties)
ANTHROPIC_API_KEY=sk-ant-...
CORPUS_MODEL=claude-sonnet-4-6

# Contextual Retrieval — situate each chunk before embedding/indexing.
# Set CONTEXT_ENABLED=false to ingest with plain text only.
CONTEXT_ENABLED=true
CONTEXT_MODEL=claude-haiku-4-5-20251001
CONTEXT_MAX_CHARS=8000
CONTEXT_CONCURRENCY=4

# Reranking — reorder hybrid-search candidates before returning.
# Set RERANK_ENABLED=false to return plain RRF ordering.
RERANK_ENABLED=true
RERANK_MODEL=claude-haiku-4-5-20251001
RERANK_CANDIDATES=50

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# Chunking tuning
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# ── Background build jobs ──────────────────────────────────────────────────
# Builds run in a durable Postgres-backed queue. In production run the worker as
# its own process:  peritus-worker  (or `just worker`).
# For single-process local dev, set RUN_WORKER_IN_PROCESS=true to run a worker
# inside the API process instead (or use `just dev-solo`).
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2               # concurrent builds per worker process
WORKER_HEARTBEAT_INTERVAL=10       # seconds between liveness beats
WORKER_STALE_TIMEOUT=90            # a running job silent this long is treated as crashed
WORKER_MAX_ATTEMPTS=3              # build retries before permanent failure
WORKER_POLL_INTERVAL=2             # idle queue poll interval (seconds)
WORKER_BACKOFF_BASE=30             # exponential retry backoff base (seconds)
JOB_EVENT_POLL_INTERVAL=0.4        # SSE tail poll interval for live builds (seconds)

# MCP server port (runs alongside FastAPI)
MCP_PORT=8001
