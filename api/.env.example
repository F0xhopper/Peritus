# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (Supabase connection pooler recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Set SUPABASE_URL to require login. Users sign in from the CLI via email OTP; the
# API verifies their access tokens and scopes every expert to its owner. Leave
# SUPABASE_URL and SUPABASE_JWT_SECRET unset to run in open dev mode (no login).
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key — used server-side to proxy GoTrue (OTP) calls. NEVER
# ship this to clients; the API is the only thing that holds it.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Legacy HS256 secret — only needed if your project has NOT migrated to asymmetric
# JWT signing keys (JWKS). Prefer signing keys; leave this unset when SUPABASE_URL
# is set and the project uses asymmetric keys.
SUPABASE_JWT_SECRET=
# Email treated as the workspace admin: sees experts that predate auth (owner NULL)
# and is the identity used in dev mode.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Base URL of this API server — used by the Python CLI's `peritus login` command.
PERITUS_SERVER_URL=http://localhost:8000

# OpenAI (embeddings)
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# Mistral AI (document parsing / OCR)
MISTRAL_API_KEY=...
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Anthropic (corpus suggestion for new specialties)
ANTHROPIC_API_KEY=sk-ant-...
CORPUS_MODEL=claude-sonnet-4-6

# Contextual Retrieval — situate each chunk before embedding/indexing.
# Set CONTEXT_ENABLED=false to ingest with plain text only.
CONTEXT_ENABLED=true
CONTEXT_MODEL=claude-haiku-4-5-20251001
CONTEXT_MAX_CHARS=8000
CONTEXT_CONCURRENCY=4

# Reranking — reorder hybrid-search candidates before returning.
# Set RERANK_ENABLED=false to return plain RRF ordering.
RERANK_ENABLED=true
RERANK_MODEL=claude-haiku-4-5-20251001
RERANK_CANDIDATES=50

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# Chunking tuning
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# MCP server port (runs alongside FastAPI)
MCP_PORT=8001
