# ── Server ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Database (PostgreSQL with the pgvector extension) ──────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/peritus
DATABASE_SSL=false

# ── API auth ────────────────────────────────────────────────────────────────
# SHA-256 hash of the API key clients must present (X-API-Key or Bearer).
# Leave unset for open local dev mode. Generate a key + hash with:
#   python -c "from peritus.api.app import keygen; keygen()"
#PERITUS_API_KEY_HASH=

# ── Anthropic (validation, graph extraction, persona, chat) ────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
# Fast model for planning, contextualisation, coverage, validation
FAST_MODEL=claude-haiku-4-5-20251001
# Graph extraction model — Haiku is sufficient and much cheaper than Sonnet
GRAPH_MODEL=claude-haiku-4-5-20251001

# ── OpenAI (embeddings) ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# ── Optional source fetchers ────────────────────────────────────────────────
# Exa neural search + YouTube discovery
#EXA_API_KEY=
# Mistral OCR (PDF parsing)
#MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── Contextual retrieval — situate each chunk before embedding ─────────────
CONTEXT_ENABLED=true
CONTEXT_MAX_CHARS=3000
CONTEXT_CONCURRENCY=4

# ── Reranking — Cohere cross-encoder when a key is set, else windowed LLM ──
RERANK_ENABLED=true
RERANK_CANDIDATES=50
RERANK_WINDOW=8
#COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ── Pipeline tuning ─────────────────────────────────────────────────────────
VALIDATE_CONCURRENCY=5
GRAPH_BATCH_SIZE=15
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# ── Background build jobs ───────────────────────────────────────────────────
# Builds run in a durable Postgres-backed queue. In production run the worker as
# its own process:  peritus-worker  (or `just worker`).
# For single-process local dev, set RUN_WORKER_IN_PROCESS=true to run a worker
# inside the API process instead (or use `just dev-solo`).
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2               # concurrent builds per worker process
WORKER_HEARTBEAT_INTERVAL=10       # seconds between liveness beats
WORKER_STALE_TIMEOUT=90            # a running job silent this long is treated as crashed
WORKER_MAX_ATTEMPTS=3              # build retries before permanent failure
WORKER_POLL_INTERVAL=2             # idle queue poll interval (seconds)
WORKER_BACKOFF_BASE=30             # exponential retry backoff base (seconds)
JOB_EVENT_POLL_INTERVAL=0.4        # SSE tail poll interval for live builds (seconds)
