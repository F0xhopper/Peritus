# ── Server ─────────────────────────────────────────────────────────────────
# Deployment environment. When "production" the server REFUSES TO START with auth
# disabled, so a missing SUPABASE_URL can never silently turn every request into
# the bootstrap admin. Set this in production.
PERITUS_ENV=development
# Allowed CORS origins for browser clients, comma-separated. The TUI/CLI are not
# browsers and ignore CORS, so this defaults to local dev origins only — widen it
# explicitly for a deployed web client, e.g. https://app.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Optional: also write backend logs to this file (API + worker). Empty = stderr
# only, which `just dev` shows in the terminal. E.g. LOG_FILE=peritus.log
LOG_FILE=

# ── Database (PostgreSQL with the pgvector extension) ──────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/peritus
DATABASE_SSL=false
# Pool sizing. One process may serve API traffic *and* run builds
# (RUN_WORKER_IN_PROCESS below), so raise the ceiling alongside WORKER_CONCURRENCY.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# Server-side statement timeout, in seconds. Without one a pathological query
# pins a pooled connection indefinitely, and DB_POOL_MAX_SIZE of those is an outage.
DB_COMMAND_TIMEOUT=30
# How long to wait for a free connection before failing. Bounds /ready and the
# retrieval path so an exhausted pool is a fast 503 rather than a hang.
DB_ACQUIRE_TIMEOUT=10
# How a filtered HNSW scan behaves when the expert_id filter rejects most of what
# the index returns. This is a CORRECTNESS setting, not a tuning knob: "off"
# silently truncates results (measured 40 rows returned for a 184-chunk expert).
# Leave it as relaxed_order unless you know why you are changing it.
HNSW_ITERATIVE_SCAN=relaxed_order

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Set SUPABASE_URL to require login. Users sign in from the CLI via email OTP; the
# API verifies their access tokens and scopes every expert to its owner. Leave
# SUPABASE_URL and SUPABASE_JWT_SECRET unset to run in open dev mode (no login).
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key — used server-side to proxy GoTrue (OTP) calls. NEVER
# ship this to clients; the API is the only thing that holds it.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Legacy HS256 secret — only needed if your project has NOT migrated to asymmetric
# JWT signing keys (JWKS). Prefer signing keys; leave this unset when SUPABASE_URL
# is set and the project uses asymmetric keys.
SUPABASE_JWT_SECRET=
# The audience claim Supabase issues on user access tokens. Only change this if
# your project issues a non-default `aud`.
SUPABASE_JWT_AUD=authenticated
# Whether email login may create brand-new accounts. False = invite-only: only
# users who already exist in Supabase Auth can log in, and the sign-in endpoint
# won't provision unknown emails.
AUTH_ALLOW_SIGNUP=true
# Per-IP throttle on the unauthenticated /auth/otp and /auth/verify endpoints:
# at most AUTH_RATE_LIMIT requests per AUTH_RATE_WINDOW seconds. Supabase enforces
# its own per-project limits too; this is the first line.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=60
# Email treated as the workspace admin: sees experts that predate auth (owner NULL)
# and is the identity used in dev mode.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Base URL of this API server — used by the Python CLI's `peritus login` command.
PERITUS_SERVER_URL=http://localhost:8000

# ── Legacy API key (optional fallback) ─────────────────────────────────────────
# SHA-256 hash of a static API key clients may present as a Bearer credential.
# Superseded by Supabase auth above; leave unset unless you rely on it. Generate
# a key + hash with:
#   python -c "from peritus.api.app import keygen; keygen()"
#PERITUS_API_KEY_HASH=

# ── Anthropic (validation, graph extraction, persona, chat) ────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Per-attempt request timeout in seconds. The SDK default is 600, and a call
# that takes ten minutes to fail holds an SSE connection, a conversation's
# stream claim and a database connection with it.
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=3
CLAUDE_MODEL=claude-sonnet-5
# Fast model for planning, contextualisation, coverage, validation
FAST_MODEL=claude-haiku-4-5-20251001
# Graph extraction model — Haiku is sufficient and much cheaper than Sonnet
GRAPH_MODEL=claude-haiku-4-5-20251001

# Research planning — one call per build that shapes the whole corpus, so it
# defaults to CLAUDE_MODEL rather than FAST_MODEL. Empty = follow CLAUDE_MODEL.
PLAN_MODEL=

# ── Anthropic Message Batches (50% off build-pipeline token costs) ──────────
# Policy for builds that don't state their own execution mode:
#   auto        — first build of an expert runs live (a user is watching it),
#                 rebuilds and scheduled refreshes batch at half price
#   interactive — every build runs live: fastest, full price
#   background  — every build batches: cheapest, hours of wall clock
BUILD_EXECUTION_DEFAULT=auto
# Triage, validation, contextualisation and graph extraction run through the
# Message Batches API at half price. Builds take longer (batches can queue up
# to ~1 hour per stage); set false to restore fast live calls at full price.
ANTHROPIC_BATCH_ENABLED=true
ANTHROPIC_BATCH_MIN_REQUESTS=4     # below this, a stage makes live calls
ANTHROPIC_BATCH_POLL_INTERVAL=15   # seconds between batch status polls
ANTHROPIC_BATCH_TIMEOUT=3600       # cancel + fall back to live after this many seconds

# ── Chat ────────────────────────────────────────────────────────────────────
# Cap on client-supplied history messages sent to Claude per turn.
CHAT_HISTORY_MAX_MESSAGES=20
# How many messages are dropped at once once that cap is exceeded. This exists for
# the prompt cache: trimming one message per turn moves the cached prefix every
# turn so it never hits, exactly when a conversation is long enough for caching to
# be worth anything. Dropping in blocks holds the prefix still for BLOCK/2 turns.
CHAT_HISTORY_TRIM_BLOCK=6
# Per-user throttle on both chat endpoints. Builds are gated by credits; chat is
# free to the user but not to us (a planning call, a rerank, a coverage check and
# a composition per message), so this is the only ceiling on what one account can
# spend. Per-process: with N API processes the real ceiling is N × this.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60

# ── OpenAI (embeddings) ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
# Two separate concurrency budgets: a chat turn embeds a few subqueries with a
# user waiting, a build embeds hundreds of chunk batches with nobody waiting.
# Sharing one lets a build queue ahead of every interactive request in the
# same process (which is exactly what RUN_WORKER_IN_PROCESS creates).
EMBED_QUERY_CONCURRENCY=8
EMBED_BATCH_CONCURRENCY=2

# ── Optional source fetchers ────────────────────────────────────────────────
# Exa neural search + YouTube discovery
#EXA_API_KEY=
# Mistral OCR (PDF parsing)
#MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── Contextual retrieval — situate each chunk before embedding ─────────────
CONTEXT_ENABLED=true
CONTEXT_MAX_CHARS=3000
CONTEXT_CONCURRENCY=4

# ── Reranking — Cohere cross-encoder when a key is set, else windowed LLM ──
# Strongly recommended: set COHERE_API_KEY. Without it every chat question
# falls back to ~7 windowed Haiku calls per retrieval pass (up to twice per
# question) — Cohere rerank is cheaper (~$2 per 1K searches) AND higher quality.
RERANK_ENABLED=true
RERANK_CANDIDATES=50
RERANK_WINDOW=8
#COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ── Pipeline tuning ─────────────────────────────────────────────────────────
VALIDATE_CONCURRENCY=5
GRAPH_BATCH_SIZE=15
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# ── Background build jobs ───────────────────────────────────────────────────
# Builds run in a durable Postgres-backed queue. In production run the worker as
# its own process:  peritus-worker  (or `just worker`).
# For single-process local dev, set RUN_WORKER_IN_PROCESS=true to run a worker
# inside the API process instead (or use `just dev-solo`).
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2               # concurrent builds per worker process
WORKER_HEARTBEAT_INTERVAL=10       # seconds between liveness beats
WORKER_STALE_TIMEOUT=90            # a running job silent this long is treated as crashed
WORKER_MAX_ATTEMPTS=3              # build retries before permanent failure
WORKER_POLL_INTERVAL=2             # idle queue poll interval (seconds)
WORKER_BACKOFF_BASE=30             # exponential retry backoff base (seconds)
JOB_EVENT_POLL_INTERVAL=0.4        # SSE tail poll interval for live builds (seconds)
