            "seq_end": 13,
            "passages": 6,
            "passage_id": 9008,
            "locus_first": "Book I, Chapter 1",
            "locus_last": "Book I, Chapter 1",
            "summary": "The adult female mite is described: its flattened body, its feeding on the fat body rather than haemolymph, and the phoretic phase spent on nurse bees between brood cycles."
          }
        ]
      },
      {
        "label": "The Reproductive Cycle",
        "held": false,
        "seq_start": 14,
        "seq_end": 19,
        "passages": 6,
        "passage_id": 9014,
        "locus_first": "Book I, Chapter 2",
        "locus_last": "Book I, Chapter 2",
