            "locus_last": null,
            "summary": "Arnott sets out why Varroa destructor, a parasite of Apis cerana, became lethal on Apis mellifera, and frames the book around the mite's dependence on capped brood."
          }
        ]
      },
      {
        "label": "The Mite and Its Host",
        "held": false,
        "seq_start": 8,
        "seq_end": 13,
        "passages": 6,
        "passage_id": 9008,
        "locus_first": "Book I, Chapter 1",
        "locus_last": "Book I, Chapter 1",
        "key_concepts": [0],
        "section_count": 1,
        "sections": [
          {
