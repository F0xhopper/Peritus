            "seq_end": 19,
            "passages": 6,
            "passage_id": 9014,
            "locus_first": "Book I, Chapter 2",
            "locus_last": "Book I, Chapter 2",
            "summary": "The foundress enters a cell some fifteen hours before capping, lays a male egg first and female eggs at thirty-hour intervals; drone brood, capped longer, yields more mated daughters."
          }
        ]
      },
      {
        "label": null,
        "held": true,
        "seq_start": 21,
        "seq_end": 40,
        "passages": 20,
        "passage_id": 9020,
        "locus_first": "Book II, Chapter 3",
        "locus_last": "Book II, Chapter 5",
