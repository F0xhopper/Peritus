        "sections": [
          {
            "seq_start": 21,
            "seq_end": 28,
            "passages": 8,
            "passage_id": 9020,
            "locus_first": "Book II, Chapter 3",
            "locus_last": "Book II, Chapter 3",
            "summary": "Seasonal population growth in temperate colonies: mite numbers double roughly monthly while brood is present, and peak as the bee population falls in late summer."
          },
          {
            "seq_start": 29,
