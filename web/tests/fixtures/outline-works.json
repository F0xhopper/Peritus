  "804": {
    "source_id": 804,
    "title": "Varroa destructor and honeybee viral loads: a five-year cohort",
    "author": "Beaumont, R. and Halvorsen, K.",
    "kind": "openalex",
    "tier": "primary",
    "passages": 34,
    "close": 34,
    "held": 0,
    "locus_first": null,
    "locus_last": null,
    "parts": [
      {
        "label": null,
        "held": false,
        "seq_start": 0,
        "seq_end": 33,
        "passages": 34,
        "passage_id": 9062,
        "locus_first": null,
        "locus_last": null,
        "key_concepts": [0, 3],
        "section_count": 3,
        "sections": [
          {
            "seq_start": 0,
            "seq_end": 11,
            "passages": 12,
            "passage_id": 9062,
            "locus_first": null,
            "locus_last": null,
            "summary": "A five-year cohort of 212 colonies across four apiaries relates mite infestation in August to viral load in October, with deformed wing virus titres rising steeply above three mites per hundred bees."
          },
          {
            "seq_start": 12,
            "seq_end": 23,
            "passages": 12,
            "passage_id": 9074,
            "locus_first": null,
            "locus_last": null,
            "summary": "Colonies above the threshold lost 61% of their winter bees before January; those treated in July stayed below it and wintered at rates indistinguishable from mite-free controls."
          },
          {
            "seq_start": 24,
            "seq_end": 33,
            "passages": 10,
            "passage_id": 9086,
            "locus_first": null,
            "locus_last": null,
            "summary": "The authors argue that the mite load in late summer, not in spring, predicts winter loss, and that monitoring thresholds published for spring understate the risk."
          }
        ]
      }
    ]
  },
